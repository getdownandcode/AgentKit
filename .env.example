# ==========================================
# AgentKit Environment Configuration
# ==========================================

# PostgreSQL & Redis Configuration
# When running locally: localhost:5432 and localhost:6379
# When running in Docker Compose: postgres:5432 and redis:6379
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=agentkit
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/agentkit
REDIS_URL=redis://localhost:6379/0

# LLM Provider Configuration
# Supported providers: "gemini", "openai", "fake"
LLM_PROVIDER=gemini
LLM_MODEL=gemini-2.0-flash
GEMINI_API_KEY=your_gemini_api_key_here
OPENAI_API_KEY=your_openai_api_key_here

# Retry policy for transient LLM failures (429 / 5xx / network). Non-transient
# errors such as 401 or 400 are never retried.
LLM_MAX_RETRIES=3
LLM_RETRY_BASE_DELAY_S=0.5
LLM_RETRY_MAX_DELAY_S=10

# External Tools & Sandboxing
SEARCH_API_KEY=your_search_api_key_here
FILE_TOOL_BASE_DIR=/tmp/agentkit_sandbox

# Security & API Authentication
# Comma-separated list of authorized client API keys. Required: AgentKit refuses
# to start when this is empty or unset, so no deployment can come up with a key
# published in this repository. Replace the values below with your own.
API_KEYS=replace_me_key_1,replace_me_key_2
RATE_LIMIT_PER_MIN=30

# Agent Execution Limits & Guardrails
MAX_STEPS=10
RUN_TIMEOUT_S=60
TOOL_TIMEOUT_S=15
SESSION_TTL_S=3600
TOOL_OUTPUT_MAX_CHARS=2000

# Real-infrastructure test suite (optional, test-only)
# `pytest` skips the live tier unless AGENTKIT_REAL_INFRA=1. Point these at a
# DEDICATED test database: the suite truncates runs/steps.
# AGENTKIT_REAL_INFRA=1
# DATABASE_TEST_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/agentkit_test
# REDIS_TEST_URL=redis://localhost:6379/15
