# Database & Storage
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/agentkit
REDIS_URL=redis://localhost:6379/0

# LLM Configuration
# Provider choices: "gemini", "openai", "fake"
LLM_PROVIDER=gemini
LLM_MODEL=gemini-2.5-flash
GEMINI_API_KEY=your_gemini_api_key_here
OPENAI_API_KEY=your_openai_api_key_here

# External Tools
SEARCH_API_KEY=your_search_api_key_here
FILE_TOOL_BASE_DIR=/tmp/agentkit_sandbox

# Security & API Authentication
# Comma-separated list of valid API keys for authenticating clients
API_KEYS=ak_test_key_12345,ak_admin_key_67890
RATE_LIMIT_PER_MIN=30

# Agent Execution Limits & Guardrails
MAX_STEPS=10
RUN_TIMEOUT_S=60
TOOL_TIMEOUT_S=15
SESSION_TTL_S=3600
TOOL_OUTPUT_MAX_CHARS=2000
